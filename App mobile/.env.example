# Copy thành mobile/.env rồi sửa. File .env KHÔNG đưa lên git.
# IP mạng LAN của máy tính đang chạy Docker (PowerShell: ipconfig, xem dòng IPv4 Address của card Wi-Fi).
# KHÔNG dùng localhost / 127.0.0.1: đó là chính điện thoại, không phải máy tính.
# Sửa xong phải chạy lại: npx expo start --clear
EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
